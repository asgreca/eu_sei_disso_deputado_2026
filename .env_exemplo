# ═══════════════════════════════════════════════════════════════
# Eu Sei Disso Deputado — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# ═══════════════════════════════════════════════════════════════

# ── OBRIGATÓRIAS ──────────────────────────────────────────────

# OpenAI (usado para análises LLM e busca semântica)
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_MODEL_NAME=gpt-4o

# API Key de segurança do backend
API_KEY=sua-api-key-secreta-aqui

# Configuração React Frontend
REACT_APP_API_URL=https://seu-dominio.com.br
REACT_APP_API_KEY=sua-api-key-secreta-aqui

# ── SERVIDOR REMOTO (se usar bancos remotos) ──────────────────

REMOTE_DB_HOST=ip-do-servidor
REMOTE_DB_USER=usuario
REMOTE_DB_PASSWORD=senha
REMOTE_DB_PATH=/caminho/dos/bancos
REMOTE_DB_PORT=22
USE_REMOTE_DB=false

# ── COLETA DE NOTÍCIAS (opcionais) ────────────────────────────

SCRAPERAPI_API_KEY=
GNEWS_API_KEY=
NEWSAPI_ORG_API_KEY=
NEWSAPI_KEY=
SERPER_API_KEY=

# ── GOOGLE / GEMINI (opcionais) ───────────────────────────────

GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── CAPTCHA SOLVERS (para scraping TSE, opcionais) ────────────

TWOCAPTCHA_API_KEY=
CAPSOLVER_API_KEY=
ANTICAPTCHA_API_KEY=

# ── TRANSPARÊNCIA BRASIL (opcional) ───────────────────────────

TRANSPARENCIA=sua-chave-api-transparencia

# ── NOTIFICAÇÕES POR EMAIL (opcional) ─────────────────────────

EMAIL_FROM=seu@email.com
EMAIL_TO=destino@email.com
EMAIL_PASSWORD=senha-app
SMTP_PORT=587

# ── DIÁRIO OFICIAL DA UNIÃO (opcional) ────────────────────────

DOU_WSINCOM_USERNAME=
DOU_WSINCOM_PASSWORD=

# ── LOGGING ───────────────────────────────────────────────────

LOG_LEVEL=INFO
